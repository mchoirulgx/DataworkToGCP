# =============================================================================
# DataWorks -> GCP Migration · Environment variables
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.
# =============================================================================

# --- Alibaba Cloud credentials (used by the DataWorks OpenAPI clients) --------
# Create an AccessKey at: RAM console -> AccessKey management
ALIBABA_ACCESS_KEY=your-access-key-id
ALIBABA_SECRET_KEY=your-access-key-secret

# --- DataWorks workspace -----------------------------------------------------
# Workspace ID, visible in the DataWorks console (Workspace page).
DATAWORKS_PROJECT_ID=12345
# Environment to extract: Prod or Dev (DataWorks Standard mode has both).
DATAWORKS_ENV=Prod
# Alibaba Cloud region, e.g. ap-southeast-5 (Jakarta), cn-hangzhou, us-west-1
ALIBABA_REGION=ap-southeast-5

# --- Extraction tuning -------------------------------------------------------
# Pause in seconds between GetNode calls to stay under the QPS limit.
CALL_DELAY_SECONDS=0.5
# Where extracted metadata (node_<id>.json) is written.
EXTRACT_OUTPUT_DIR=../data/extract

# --- MySQL checkpoint store --------------------------------------------------
# The script persists extracted records here so a run can resume after a crash:
# workflows/nodes/tables already stored are skipped (append-only INSERT IGNORE)
# and only missing items are extracted, then their files are regenerated.
# Create the database first, e.g.:  CREATE DATABASE dataworks_extract CHARACTER SET utf8mb4;
# Local dev container (Docker):  docker run -d --name dataworks-mysql \
#   -e MYSQL_ROOT_PASSWORD="$MYSQL_PASSWORD" -e MYSQL_DATABASE=dataworks_extract -p 3306:3306 mysql:8.0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Generate one, e.g.:  openssl rand -base64 24
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=dataworks_extract

# --- GCP / Dataform target (read by the Composer DAG) ------------------------
# code/gcp/dags/house_buying_daily.py reads these via os.getenv with defaults.
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=asia-southeast2
DATAFORM_REPOSITORY_ID=house-buying-analysis
DATAFORM_GIT_BRANCH=main
# Schedule for the HAND-WRITTEN sample DAG only (code/gcp/dags/house_buying_daily.py).
# GENERATED DAGs take their schedule from the FlowSpec trigger or the CSV override,
# not from here.
# NOTE: `0 2 * * *` is 02:00 daily. The sample workflow's DataWorks cron
# `00 02 00 * * ?` is Quartz (s m h) = 00:02 daily, so this default does NOT match
# the source workflow. See docs/reference/variables-and-macros.md.
DAG_SCHEDULE=0 2 * * *

# --- Automatic migration (migrate/migrate.py) ---------------------------------
# Where the generator writes the Dataform project + DAGs + review reports.
GENERATED_OUTPUT_DIR=../data/generated
# Airflow major version that the generated `dags/` folder targets (2 or 3).
# Version-specific DAG variants are ALWAYS emitted into both `version_2/dags/`
# and `version_3/dags/`; this setting only picks which one `dags/` mirrors.
AIRFLOW_MAJOR_VERSION=3
# Dataform CLI binary (npm -g @dataform/cli installs `dataform`).
DATAFORM_CLI=dataform
# Must match the installed Dataform CLI version (dataform --version).
DATAFORM_CORE_VERSION=3.0.64

# Dataform schemas. Dataform config is committed literally (workflow_settings.yaml
# / dataform.json / *.sqlx), so it CANNOT read env vars — keep the values below
# and the Dataform files in sync.
DATAFORM_DEFAULT_SCHEMA=dwh
DATAFORM_ASSERTION_SCHEMA=dwh_assertions
